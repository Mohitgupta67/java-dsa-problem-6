public class Problem {

    // This method checks whether it is safe to put a number
    // at the given row and column.
    public static boolean isSafe(char[][] board, int row, int col, int number) {

        // Convert integer number into character
        char num = (char) (number + '0');

        // 1. Check the column
        for (int i = 0; i < board.length; i++) {
            if (board[i][col] == num) {
                return false;
            }
        }

        // 2. Check the row
        for (int j = 0; j < board[0].length; j++) {
            if (board[row][j] == num) {
                return false;
            }
        }

        // 3. Find the starting row of the 3 x 3 box
        int startRow = (row / 3) * 3;

        // Find the starting column of the 3 x 3 box
        int startCol = (col / 3) * 3;

        // Check the 3 x 3 box
        for (int i = startRow; i < startRow + 3; i++) {
            for (int j = startCol; j < startCol + 3; j++) {

                if (board[i][j] == num) {
                    return false;
                }
            }
        }

        // If number is not found anywhere,
        // it is safe to put it.
        return true;
    }

    // This method solves the Sudoku using backtracking.
    public static boolean solveSudoku(char[][] board) {

        // Find an empty cell
        for (int row = 0; row < 9; row++) {

            for (int col = 0; col < 9; col++) {

                // '.' means the cell is empty
                if (board[row][col] == '.') {

                    // Try numbers 1 to 9
                    for (int number = 1; number <= 9; number++) {

                        // Check whether this number is safe
                        if (isSafe(board, row, col, number)) {

                            // Put the number
                            board[row][col] =
                                    (char) (number + '0');

                            // Recursively solve the remaining Sudoku
                            if (solveSudoku(board)) {
                                return true;
                            }

                            // If solution didn't work,
                            // remove the number.
                            board[row][col] = '.';
                        }
                    }

                    // No number worked in this cell
                    return false;
                }
            }
        }

        // No empty cells remain.
        // Sudoku is solved.
        return true;
    }

    // Prints the Sudoku board
    public static void printBoard(char[][] board) {

        for (int i = 0; i < 9; i++) {

            for (int j = 0; j < 9; j++) {
                System.out.print(board[i][j] + " ");
            }

            System.out.println();
        }
    }

    // Main method
    public static void main(String[] args) {

        // Sudoku puzzle
        char[][] board = {
            {'5', '3', '.', '.', '7', '.', '.', '.', '.'},
            {'6', '.', '.', '1', '9', '5', '.', '.', '.'},
            {'.', '9', '8', '.', '.', '.', '.', '6', '.'},

            {'8', '.', '.', '.', '6', '.', '.', '.', '3'},
            {'4', '.', '.', '8', '.', '3', '.', '.', '1'},
            {'7', '.', '.', '.', '2', '.', '.', '.', '6'},

            {'.', '6', '.', '.', '.', '.', '2', '8', '.'},
            {'.', '.', '.', '4', '1', '9', '.', '.', '5'},
            {'.', '.', '.', '.', '8', '.', '.', '7', '9'}
        };

        // Solve the Sudoku
        solveSudoku(board);

        // Print the solved Sudoku
        printBoard(board);
    }
}